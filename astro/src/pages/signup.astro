---
import AuthLayout from '../layouts/AuthLayout.astro';
---
<AuthLayout title="Create account"><section class="auth-card"><p class="eyebrow">Get started</p><h1>Make shared spending feel easy.</h1><p class="auth-muted">Create your free workspace in under a minute.</p>{Astro.url.searchParams.get('error') && <p class="form-error" role="alert">{Astro.url.searchParams.get('error')}</p>}<form method="POST" action="/api/auth/signup"><label>Your name<input name="name" required placeholder="Jordan Miller" /></label><label>Email address<input type="email" name="email" required autocomplete="email" placeholder="you@example.com" /></label><label>Create a password<input type="password" name="password" minlength="8" required autocomplete="new-password" placeholder="At least 8 characters" /></label><button class="button auth-submit" type="submit">Create account <span>→</span></button></form><p class="auth-switch">Already have an account? <a href="/login">Sign in</a></p></section></AuthLayout>
