---
import Layout from '../../layouts/Layout.astro';
import { ObjectId } from 'mongodb';
import { getDb } from '../../lib/server/db.js';
const rawId = Astro.params.groupId;
if (!ObjectId.isValid(rawId)) return Astro.redirect('/dashboard');
const db = await getDb(); const groupId = new ObjectId(rawId); const userId = new ObjectId(Astro.locals.user.id);
const group = await db.collection('groups').findOne({ _id: groupId, memberIds: userId });
if (!group) return Astro.redirect('/dashboard');
const users = await db.collection('users').find({ _id: { $in: group.memberIds } }, { projection: { name: 1, email: 1 } }).toArray();
const names = Object.fromEntries(users.map((user) => [user._id.toString(), user.name]));
const expenses = await db.collection('expenses').find({ groupId, deletedAt: null }).sort({ date: -1 }).toArray();
const isCreator = group.createdBy?.equals(userId) || false;
const pendingRequests = isCreator ? await db.collection('groupJoinRequests').find({ groupId, status: 'pending' }).toArray() : [];
const requestUsers = pendingRequests.length ? await db.collection('users').find({ _id: { $in: pendingRequests.map((request) => request.userId) } }, { projection: { name: 1, email: 1 } }).toArray() : [];
const requestMap = Object.fromEntries(requestUsers.map((user) => [user._id.toString(), user]));
const dollars = (cents) => `$${(Number(cents || 0) / 100).toFixed(2)}`;
const splitsFor = (expense) => expense.splits?.length ? expense.splits : group.memberIds.map((memberId) => ({ userId: memberId, paid: false, shareCents: 0 }));
const paidCount = (expense) => splitsFor(expense).filter((split) => split.paid).length;
---
<Layout title={group.name}><div class="page"><section class="group-hero"><div><p class="eyebrow" style="color:#b7b0ff">Shared group</p><h1>{group.name}</h1><p>{group.memberIds.length} members · Equal splits</p></div><a class="button" href={`/groups/${group._id}/expenses/new`}>＋ Add expense</a></section>{isCreator && <section class="panel" style="margin-bottom:20px"><div class="panel-heading"><div><h2>Join requests</h2><p>Review people asking to join this group.</p></div><span class="tag peach">{pendingRequests.length} pending</span></div>{pendingRequests.length ? pendingRequests.map((request) => <div class="notification unread"><a href={`/groups/${group._id}/settings`}><strong>{requestMap[request.userId.toString()]?.name || 'Unknown user'}</strong><p>{requestMap[request.userId.toString()]?.email || ''} requested to join {group.name}. Click to review.</p></a><span style="display:flex;gap:7px"><form method="POST" action="/api/groups/request"><input type="hidden" name="groupId" value={group._id} /><input type="hidden" name="requestId" value={request._id} /><input type="hidden" name="decision" value="declined" /><button class="read-button" type="submit">Decline</button></form><form method="POST" action="/api/groups/request"><input type="hidden" name="groupId" value={group._id} /><input type="hidden" name="requestId" value={request._id} /><input type="hidden" name="decision" value="approved" /><button class="button" style="padding:7px 10px;font-size:.7rem" type="submit">Accept</button></form></span></div>) : <div class="empty-state">No pending join requests.</div>}</section>}<div class="dashboard-grid"><section class="panel"><div class="panel-heading"><div><h2>Group ledger</h2><p>Click an expense to see who has paid and who is still pending.</p></div></div>{expenses.length ? <div class="expense-list">{expenses.map((expense) => <details class="expense-disclosure"><summary><span class="expense-summary"><span class="expense-name"><span class="expense-icon">✦</span><span><strong>{expense.description}</strong><small>{expense.date} · {expense.category} · Paid by {expense.payerName || names[expense.payerId?.toString()] || 'Member'}</small></span></span><span class={`payment-status ${paidCount(expense) === splitsFor(expense).length ? 'payment-complete' : 'payment-pending'}`}>{paidCount(expense) === splitsFor(expense).length ? 'Everyone paid' : `${paidCount(expense)}/${splitsFor(expense).length} paid`}</span><span class="expense-total">{dollars(expense.amountCents)}</span></span></summary><div class="payment-details"><div class="payment-details-heading"><strong>Payment status</strong><a href={`/groups/${group._id}/expenses/edit?id=${expense._id}`}>Edit expense</a></div>{splitsFor(expense).map((split) => <div class="balance-line"><span class="balance-person"><span class={`avatar ${split.paid ? 'avatar-green' : 'avatar-coral'}`}>{(names[split.userId.toString()] || '?').slice(0,2).toUpperCase()}</span><span><strong>{names[split.userId.toString()] || 'Member'}</strong><small>{dollars(split.shareCents)}</small></span></span><form method="POST" action="/api/expenses/paid"><input type="hidden" name="groupId" value={group._id} /><input type="hidden" name="expenseId" value={expense._id} /><input type="hidden" name="memberId" value={split.userId} /><button class={`tag ${split.paid ? 'mint' : 'peach'}`} type="submit">{split.paid ? 'Paid' : 'Mark paid'}</button></form></div>)}</div></details>)}</div> : <div class="empty-state">No expenses yet. Add the first shared cost.</div>}</section><aside><section class="panel"><div class="panel-heading"><div><h2>Members</h2><p>Who’s in {group.name}</p></div><span class="card-link">{group.memberIds.length} people</span></div>{group.memberIds.map((memberId, index) => <div class="balance-line"><span class="balance-person"><span class={`avatar ${['avatar-lilac','avatar-blue','avatar-coral','avatar-green'][index % 4]}`}>{(names[memberId.toString()] || '?').slice(0, 2).toUpperCase()}</span><span><strong>{names[memberId.toString()] || 'Unknown member'}</strong><small>{memberId.equals(group.createdBy) ? 'Group creator' : 'Member'}</small></span></span></div>)}</section><div class="section-spacer"></div>{isCreator && <section class="panel"><div class="panel-heading"><div><h2>Group settings</h2><p>Update the shared space</p></div></div><a class="button secondary" href={`/groups/${group._id}/settings`}>Edit group →</a></section>}</aside></div></div></Layout>
