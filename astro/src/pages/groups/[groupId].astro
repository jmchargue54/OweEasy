---
import Layout from '../../layouts/Layout.astro';
import { ObjectId } from 'mongodb';
import { getDb } from '../../lib/server/db.js';
const rawId = Astro.params.groupId;
if (!ObjectId.isValid(rawId)) return Astro.redirect('/dashboard');
const db = await getDb(); const groupId = new ObjectId(rawId); const userId = new ObjectId(Astro.locals.user.id);
const group = await db.collection('groups').findOne({ _id: groupId, memberIds: userId });
if (!group) return Astro.redirect('/dashboard');
const users = await db.collection('users').find({ _id: { $in: group.memberIds } }, { projection: { name: 1, email: 1 } }).toArray();
const names = Object.fromEntries(users.map((user) => [user._id.toString(), user.name]));
const expenses = await db.collection('expenses').find({ groupId, deletedAt: null }).sort({ date: -1 }).toArray();
const isCreator = group.createdBy?.equals(userId) || false;
const dollars = (cents) => `$${(Number(cents || 0) / 100).toFixed(2)}`;
---
<Layout title={group.name}><div class="page"><section class="group-hero"><div><p class="eyebrow" style="color:#b7b0ff">Shared group</p><h1>{group.name}</h1><p>{group.memberIds.length} members · Equal splits</p></div><a class="button" href={`/groups/${group._id}/expenses/new`}>＋ Add expense</a></section><div class="dashboard-grid"><section class="panel"><div class="panel-heading"><div><h2>Group ledger</h2><p>Every active expense, in one place</p></div><a class="card-link" href={`/groups/${group._id}/balances`}>Balances →</a></div>{expenses.length ? <table class="ledger-table"><thead><tr><th>Expense</th><th>Paid by</th><th>Split</th><th>Total</th></tr></thead><tbody>{expenses.map((expense) => <tr><td><div class="expense-name"><span class="expense-icon">✦</span><span><strong>{expense.description}</strong><small>{expense.date} · {expense.category}</small></span></div></td><td><small>{expense.payerName || names[expense.payerId?.toString()] || 'Member'}</small></td><td><span class="tag peach">{expense.splits?.length || group.memberIds.length} shares</span></td><td class="amount">{dollars(expense.amountCents)}<small><a href={`/groups/${group._id}/expenses/edit?id=${expense._id}`}>Edit</a></small></td></tr>)}</tbody></table> : <div class="empty-state">No expenses yet. Add the first shared cost.</div>}</section><aside><section class="panel"><div class="panel-heading"><div><h2>Members</h2><p>Who’s in {group.name}</p></div><span class="card-link">{group.memberIds.length} people</span></div>{group.memberIds.map((memberId, index) => <div class="balance-line"><span class="balance-person"><span class={`avatar ${['avatar-lilac','avatar-blue','avatar-coral','avatar-green'][index % 4]}`}>{(names[memberId.toString()] || '?').slice(0, 2).toUpperCase()}</span><span><strong>{names[memberId.toString()] || 'Unknown member'}</strong><small>{memberId.equals(group.createdBy) ? 'Group creator' : 'Member'}</small></span></span></div>)}</section><div class="section-spacer"></div><section class="panel"><div class="panel-heading"><div><h2>Group settings</h2><p>Update the shared space</p></div></div>{isCreator ? <><a class="button secondary" href={`/groups/${group._id}/settings`}>Edit group →</a><a class="button ghost" href={`/groups/${group._id}/balances`}>View balances →</a></> : <a class="button ghost" href={`/groups/${group._id}/balances`}>View balances →</a>}</section></aside></div><div class="section-spacer"></div>{expenses.slice(0, 3).map((expense) => <section class="panel" style="margin-bottom:20px"><div class="panel-heading"><div><h2>{expense.description} payment status</h2><p>{dollars(expense.amountCents)} · The expense creator may update any participant.</p></div></div>{(expense.splits || []).map((split) => <div class="balance-line"><span class="balance-person"><span class="avatar avatar-blue">{(names[split.userId.toString()] || '?').slice(0,2).toUpperCase()}</span>{names[split.userId.toString()] || 'Member'} <small>{dollars(split.shareCents)}</small></span><form method="POST" action="/api/expenses/paid"><input type="hidden" name="groupId" value={group._id} /><input type="hidden" name="expenseId" value={expense._id} /><input type="hidden" name="memberId" value={split.userId} /><button class={`tag ${split.paid ? 'mint' : 'peach'}`} type="submit">{split.paid ? 'Paid' : 'Mark paid'}</button></form></div>)}</section>)}</div></Layout>
