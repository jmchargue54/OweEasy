---
import Layout from '../../../layouts/Layout.astro';
import { ObjectId } from 'mongodb';
import { getDb } from '../../../lib/server/db.js';
const rawId = Astro.params.groupId; if (!ObjectId.isValid(rawId)) return Astro.redirect('/dashboard');
const db = await getDb(); const groupId = new ObjectId(rawId); const userId = new ObjectId(Astro.locals.user.id); const group = await db.collection('groups').findOne({ _id: groupId, memberIds: userId }); if (!group) return Astro.redirect('/dashboard');
const users = await db.collection('users').find({ _id: { $in: group.memberIds } }, { projection: { name: 1 } }).toArray(); const names = Object.fromEntries(users.map((item) => [item._id.toString(), item.name])); const balances = Object.fromEntries(group.memberIds.map((id) => [id.toString(), 0])); const expenses = await db.collection('expenses').find({ groupId, deletedAt: null }).toArray(); for (const expense of expenses) { if (expense.payerId) balances[expense.payerId.toString()] = (balances[expense.payerId.toString()] || 0) + expense.amountCents; for (const split of expense.splits || []) balances[split.userId.toString()] = (balances[split.userId.toString()] || 0) - split.shareCents; }
const dollars = (cents) => `${cents < 0 ? '−' : '+'}$${Math.abs(cents / 100).toFixed(2)}`;
---
<Layout title="Balances"><div class="page"><header class="page-heading"><div><p class="eyebrow">{group.name} · Balances</p><h1>Balances that make sense.</h1><p>Every number below traces back to the active group ledger.</p></div><a class="button" href={`/groups/${group._id}/expenses/new`}>＋ Add an expense</a></header><div class="balance-grid"><section class="panel balance-card"><div class="panel-heading"><div><h2>Your net position</h2><p>After {expenses.length} active expenses</p></div><span class="tag mint">Live</span></div><div class="balance-amount">{dollars(balances[userId.toString()] || 0)}</div><div class="balance-caption">Positive means the group owes you; negative means you owe the group.</div><div class="section-spacer"></div><a class="card-link" href={`/groups/${group._id}`}>Trace back to the ledger →</a></section><section class="panel"><div class="panel-heading"><div><h2>Who owes whom</h2><p>Raw balances before settlement</p></div></div>{group.memberIds.map((id, index) => <div class="balance-line"><span class="balance-person"><span class={`avatar ${['avatar-lilac','avatar-blue','avatar-coral','avatar-green'][index % 4]}`}>{(names[id.toString()] || '?').slice(0,2).toUpperCase()}</span><span>{names[id.toString()] || 'Member'}<small>from active expenses</small></span></span><strong class={(balances[id.toString()] || 0) >= 0 ? 'positive' : 'negative'}>{dollars(balances[id.toString()] || 0)}</strong></div>)}</section></div><div class="section-spacer"></div><section class="panel"><div class="panel-heading"><div><h2>Settlement history</h2><p>Settlements are stored separately from expenses.</p></div></div><div class="empty-state">No settlement records have been recorded yet.</div></section></div></Layout>
