---
import Layout from '../../../../layouts/Layout.astro';
import { ObjectId } from 'mongodb';
import { getDb } from '../../../../lib/server/db.js';
const rawId = Astro.params.groupId; if (!ObjectId.isValid(rawId)) return Astro.redirect('/dashboard');
const db = await getDb(); const groupId = new ObjectId(rawId); const group = await db.collection('groups').findOne({ _id: groupId, memberIds: new ObjectId(Astro.locals.user.id) });
if (!group) return Astro.redirect('/dashboard');
const members = await db.collection('users').find({ _id: { $in: group.memberIds } }, { projection: { name: 1 } }).toArray();
---
<Layout title="Add expense"><div class="page"><header class="page-heading"><div><p class="eyebrow">{group.name}</p><h1>Add an expense</h1><p>Give everyone the context they need to understand the split.</p></div><a class="button secondary" href={`/groups/${group._id}`}>← Back to ledger</a></header><div class="form-layout"><form class="panel form-card" method="POST" action="/api/expenses/save"><input type="hidden" name="groupId" value={group._id} /><label>Description<input required name="description" placeholder="e.g. Weekly groceries" /></label><div class="two-col"><label>Amount (USD)<input required name="amount" type="number" min="0.01" step="0.01" placeholder="0.00" /></label><label>Date<input required name="date" type="date" value="2026-10-21" /></label></div><div class="two-col"><label>Category<select name="category"><option>Household</option><option>Groceries</option><option>Utilities</option><option>Travel</option></select></label><label>Paid by<input name="payerName" value={Astro.locals.user.name} readonly /></label></div><fieldset><legend>Include members in this split</legend>{members.map((member) => <label class="member"><input type="checkbox" name="memberIds" value={member._id} checked />{member.name}</label>)}</fieldset><button class="button" type="submit">Save expense</button></form><aside class="split-preview"><h2>Equal split preview</h2><p style="color:#aaa9b8;font-size:.78rem;margin:5px 0">{members.length} members in {group.name}</p><div class="split-total">Equal shares</div><p style="color:#aaa9b8;font-size:.78rem">The exact cent split is calculated securely on the server.</p></aside></div></div></Layout>
