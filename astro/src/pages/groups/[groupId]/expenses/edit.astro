---
import Layout from '../../../../layouts/Layout.astro';
import { ObjectId } from 'mongodb';
import { getDb } from '../../../../lib/server/db.js';
const rawGroupId = Astro.params.groupId; const rawExpenseId = Astro.url.searchParams.get('id');
if (!ObjectId.isValid(rawGroupId) || !ObjectId.isValid(rawExpenseId)) return Astro.redirect('/dashboard');
const db = await getDb(); const groupId = new ObjectId(rawGroupId); const expenseId = new ObjectId(rawExpenseId); const group = await db.collection('groups').findOne({ _id: groupId, memberIds: new ObjectId(Astro.locals.user.id) }); const expense = await db.collection('expenses').findOne({ _id: expenseId, groupId, deletedAt: null });
if (!group || !expense) return Astro.redirect(`/groups/${rawGroupId}`);
---
<Layout title="Edit expense"><div class="page"><header class="page-heading"><div><p class="eyebrow">{group.name} · Edit</p><h1>Update an expense.</h1><p>Correct the details and OweEasy will recalculate the equal shares.</p></div><a class="button secondary" href={`/groups/${group._id}`}>Cancel</a></header><form class="panel form-card" style="max-width:700px" method="POST" action="/api/expenses/save"><input type="hidden" name="groupId" value={group._id} /><input type="hidden" name="expenseId" value={expense._id} /><label>Description<input required name="description" value={expense.description} /></label><div class="two-col"><label>Amount (USD)<input required name="amount" type="number" min="0.01" step="0.01" value={(expense.amountCents / 100).toFixed(2)} /></label><label>Date<input required name="date" type="date" value={expense.date} /></label></div><div class="two-col"><label>Category<select name="category"><option selected={expense.category === 'Household'}>Household</option><option selected={expense.category === 'Groceries'}>Groceries</option><option selected={expense.category === 'Utilities'}>Utilities</option><option selected={expense.category === 'Travel'}>Travel</option></select></label><label>Paid by<input name="payerName" value={expense.payerName || Astro.locals.user.name} readonly /></label></div><div style="display:flex;gap:10px;align-items:center"><button class="button" type="submit">Save changes</button></div></form><form method="POST" action="/api/expenses/delete" style="max-width:700px;margin-top:12px"><input type="hidden" name="groupId" value={group._id} /><input type="hidden" name="expenseId" value={expense._id} /><button class="button secondary" type="submit">Delete expense</button></form></div></Layout>
