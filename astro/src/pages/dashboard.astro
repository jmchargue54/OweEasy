---
import Layout from '../layouts/Layout.astro';
import { getDb } from '../lib/server/db.js';
import { ObjectId } from 'mongodb';
const db = await getDb(); const userId = new ObjectId(Astro.locals.user.id); const groups = await db.collection('groups').find({ memberIds: userId }).sort({ createdAt: -1 }).toArray(); const groupIds = groups.map((group) => group._id); const expenses = await db.collection('expenses').find({ groupId: { $in: groupIds }, deletedAt: null }).sort({ date: -1 }).limit(8).toArray(); const groupNames = Object.fromEntries(groups.map((group) => [group._id.toString(), group.name])); const dollars = (cents) => `$${(Number(cents || 0) / 100).toFixed(2)}`;
const inbox = await db.collection('notifications').find({ userId }).sort({ createdAt: -1 }).limit(5).toArray();
const unreadInboxCount = await db.collection('notifications').countDocuments({ userId, readAt: null });
const allActiveExpenses = await db.collection('expenses').find({ groupId: { $in: groupIds }, deletedAt: null }, { projection: { splits: 1 } }).toArray();
const unpaidExpenseCount = allActiveExpenses.filter((expense) => !expense.splits?.length || expense.splits.some((split) => !split.paid)).length;
const notificationHref = (notification) => notification.type === 'join-request' && notification.groupId ? `/groups/${notification.groupId}/settings` : '/notifications';
---
<Layout title="Overview"><div class="page"><header class="page-heading"><div><p class="eyebrow">Your workspace</p><h1>A clearer way to split up.</h1><p>Good morning, {Astro.locals.user.name}. Here’s what moved while you were away.</p></div><a class="button" href="/groups/new">＋ Create group</a></header><section class="summary-strip"><div class="summary-cell"><span class="summary-label">Groups</span><strong class="summary-value positive">{groups.length}</strong></div><div class="summary-cell"><span class="summary-label">Active expenses</span><strong class="summary-value negative">{unpaidExpenseCount}</strong></div><div class="summary-cell"><span class="summary-label">Inbox</span><strong class="summary-value positive">{unreadInboxCount}</strong></div></section><section class="panel" style="margin-bottom:20px"><div class="panel-heading"><div><h2>Your groups</h2><p>Choose a shared space or start a new one</p></div><div style="display:flex;gap:12px"><a class="card-link" href="/groups/join">Join a group →</a><a class="card-link" href="/groups/new">＋ Create group</a></div></div>{groups.length ? <div class="quick-actions" style="grid-template-columns:repeat(2,minmax(0,1fr))">{groups.map((group) => <a href={`/groups/${group._id}`}><strong>{group.name}</strong><small style="display:block;color:var(--muted);font-weight:400">{group.memberIds.length} members · {group.description || 'Shared expenses'}</small></a>)}</div> : <div class="empty-state">You do not belong to a group yet.</div>}</section><div class="dashboard-grid"><section class="panel"><div class="panel-heading"><div><h2>Recent activity</h2><p>Active expenses across your groups</p></div></div>{expenses.length ? <table class="ledger-table"><thead><tr><th>Expense</th><th>Group</th><th>Total</th></tr></thead><tbody>{expenses.map((expense) => <tr><td><div class="expense-name"><span class="expense-icon">✦</span><span><strong>{expense.description}</strong><small>{expense.date} · {expense.category}</small></span></div></td><td><small>{groupNames[expense.groupId.toString()]}</small></td><td class="amount">{dollars(expense.amountCents)}</td></tr>)}</tbody></table> : <div class="empty-state">Your recent expenses will appear here.</div>}</section><aside><section class="panel balance-card"><div class="panel-heading"><div><h2>Account</h2><p>Signed in securely</p></div><span class="tag mint">Active</span></div><div class="balance-amount" style="font-size:1.6rem">{Astro.locals.user.name}</div><div class="balance-caption">{Astro.locals.user.email}</div><div class="section-spacer"></div><a class="button secondary" href="/profile">Edit profile</a></section></aside></div><div class="section-spacer"></div><section class="panel"><div class="panel-heading"><div><h2>Inbox</h2><p>Requests and updates that need your attention</p></div><a class="card-link" href="/notifications">Open inbox →</a></div>{inbox.length ? inbox.map((notification) => <a class:list-unread={!notification.readAt} class="notification inbox-item" href={notificationHref(notification)}><div><strong>{notification.title}</strong><p>{notification.message}</p><small>{new Date(notification.createdAt).toLocaleString()}</small></div><span class="card-link">View →</span></a>) : <div class="empty-state">You’re all caught up.</div>}</section></div></Layout>
