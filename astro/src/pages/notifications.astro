---
import Layout from '../layouts/Layout.astro';
import { getDb } from '../lib/server/db.js';
import { ObjectId } from 'mongodb';
const db = await getDb(); const notifications = await db.collection('notifications').find({ userId: new ObjectId(Astro.locals.user.id) }).sort({ createdAt: -1 }).limit(100).toArray();
const notificationHref = (notification) => notification.type === 'join-request' && notification.groupId ? `/groups/${notification.groupId}/settings` : null;
---
<Layout title="Inbox"><div class="page"><header class="page-heading"><div><p class="eyebrow">Stay in the loop</p><h1>Your inbox</h1><p>Small updates that keep shared costs from becoming awkward.</p></div>{notifications.some((item) => !item.readAt) && <form method="POST" action="/api/notifications/read"><input type="hidden" name="all" value="true" /><button class="button secondary" type="submit">Mark all as read</button></form>}</header><section class="panel">{notifications.length ? notifications.map((notification) => <article class:list-unread={!notification.readAt} class="notification" data-notification-id={notification._id}><div>{notificationHref(notification) ? <a href={notificationHref(notification)} data-notification-link><strong>{notification.title}</strong><p>{notification.message} Click to review and accept or decline.</p></a> : <button class="notification-message" type="button" data-notification-link><strong>{notification.title}</strong><p>{notification.message}</p></button>}<small>{new Date(notification.createdAt).toLocaleString()}</small></div>{!notification.readAt && <form method="POST" action="/api/notifications/read"><input type="hidden" name="notificationId" value={notification._id} /><button class="read-button" type="submit">Mark read</button></form>}</article>) : <div class="empty-state">You’re all caught up.</div>}</section></div><script>
const markRead = (notificationId) => fetch('/api/notifications/read', { method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded' }, body: new URLSearchParams({ notificationId }) });
document.querySelectorAll('[data-notification-link]').forEach((message) => message.addEventListener('click', async (event) => { const item = event.currentTarget.closest('[data-notification-id]'); if (item?.classList.contains('unread')) { event.preventDefault(); await markRead(item.dataset.notificationId); if (event.currentTarget.href) window.location.href = event.currentTarget.href; } }));
setTimeout(() => document.querySelectorAll('.notification.unread[data-notification-id]').forEach((item) => { markRead(item.dataset.notificationId); item.classList.remove('unread'); }), 5000);
</script></Layout>
