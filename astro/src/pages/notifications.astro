---
import Layout from '../layouts/Layout.astro';
import { getDb } from '../lib/server/db.js';
import { ObjectId } from 'mongodb';
const db = await getDb(); const notifications = await db.collection('notifications').find({ userId: new ObjectId(Astro.locals.user.id) }).sort({ createdAt: -1 }).limit(100).toArray();
const pendingRequestIds = new Set((await db.collection('groupJoinRequests').find({ _id: { $in: notifications.filter((item) => item.type === 'join-request' && item.requestId).map((item) => item.requestId) }, status: 'pending' }).project({ _id: 1 }).toArray()).map((item) => item._id.toString()));
const isPendingJoinRequest = (notification) => notification.type === 'join-request' && notification.groupId && notification.requestId && pendingRequestIds.has(notification.requestId.toString());
---
<Layout title="Inbox"><div class="page"><header class="page-heading"><div><p class="eyebrow">Stay in the loop</p><h1>Your inbox</h1><p>Small updates that keep shared costs from becoming awkward.</p></div>{notifications.some((item) => !item.readAt) && <form method="POST" action="/api/notifications/read"><input type="hidden" name="all" value="true" /><button class="button secondary" type="submit">Mark all as read</button></form>}</header><section class="panel">{notifications.length ? notifications.map((notification) => <article class:list-unread={!notification.readAt} class="notification" data-notification-id={notification._id}><div><button class="notification-message" type="button" data-notification-link><strong>{notification.title}</strong><p>{notification.message}{isPendingJoinRequest(notification) ? ' Choose an action below.' : ''}</p></button><small>{new Date(notification.createdAt).toLocaleString()}</small>{isPendingJoinRequest(notification) && <div class="notification-actions"><form method="POST" action="/api/groups/request"><input type="hidden" name="groupId" value={notification.groupId} /><input type="hidden" name="requestId" value={notification.requestId} /><input type="hidden" name="notificationId" value={notification._id} /><input type="hidden" name="returnTo" value="/notifications" /><input type="hidden" name="decision" value="declined" /><button class="read-button" type="submit">Deny</button></form><form method="POST" action="/api/groups/request"><input type="hidden" name="groupId" value={notification.groupId} /><input type="hidden" name="requestId" value={notification.requestId} /><input type="hidden" name="notificationId" value={notification._id} /><input type="hidden" name="returnTo" value="/notifications" /><input type="hidden" name="decision" value="approved" /><button class="button" type="submit">Approve</button></form></div>}</div>{!notification.readAt && <form method="POST" action="/api/notifications/read"><input type="hidden" name="notificationId" value={notification._id} /><button class="read-button" type="submit">Mark read</button></form>}</article>) : <div class="empty-state">You’re all caught up.</div>}</section></div><script>
const markRead = (notificationId) => fetch('/api/notifications/read', { method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded' }, body: new URLSearchParams({ notificationId }) });
document.querySelectorAll('[data-notification-link]').forEach((message) => message.addEventListener('click', async (event) => { const item = (event.currentTarget as HTMLElement).closest('[data-notification-id]') as HTMLElement | null; if (item?.classList.contains('list-unread')) { await markRead(item.dataset.notificationId); item.classList.remove('list-unread'); item.querySelector('form[action="/api/notifications/read"]')?.remove(); } }));
</script></Layout>
